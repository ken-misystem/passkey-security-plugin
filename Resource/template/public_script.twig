<script nonce="{{ nonce }}">(()=>{'use strict';const endpoint={{ endpoint|json_encode(15)|raw }},token={{ csrf_token(csrf_id)|json_encode(15)|raw }},status=document.getElementById('status');let busy=false,review=false;const value=id=>document.getElementById(id)?.value||'';
const reopen=document.createElement('button');reopen.type='button';reopen.textContent='画面を開き直して状態を確認する';reopen.hidden=true;status.after(reopen);reopen.addEventListener('click',()=>location.reload());
function reviewError(message,delay=0){const e=Error(message);e.review=true;e.delay=delay;return e;}
const encode=b=>{let s='';for(const v of new Uint8Array(b))s+=String.fromCharCode(v);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');};
const convert=v=>{if(typeof v==='string'&&v.startsWith('=?BINARY?B?')&&v.endsWith('?='))return Uint8Array.from(atob(v.slice(11,-2)),c=>c.charCodeAt(0));if(Array.isArray(v))return v.map(convert);if(v&&typeof v==='object')return Object.fromEntries(Object.entries(v).map(([k,x])=>[k,convert(x)]));return v;};
async function post(action,data={}){const ac=new AbortController(),timer=setTimeout(()=>ac.abort(),15000);try{const r=await fetch(endpoint,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({_token:token,action,...data}),signal:ac.signal});if(r.status===503){const id=r.headers.get('X-PasskeySecurity-Incident')||'',ref=/^[a-f0-9]{32}$/.test(id)?' 照会番号：'+id:'';throw reviewError('処理を完了できませんでした。2秒以上待ち、画面を開き直して状態を確認してください。同じ操作は自動で再送されません。'+ref,2000);}if(r.status>=500)throw reviewError('処理結果を確認できません。同じ操作を繰り返さず、画面を開き直して状態を確認してください。');const j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'確認できませんでした。');return j;}finally{clearTimeout(timer);}}
function bind(id,fn){const b=document.getElementById(id);if(b)b.addEventListener('click',()=>run(fn));}
async function run(fn){if(busy||review)return;busy=true;document.querySelectorAll('button').forEach(b=>b.disabled=true);status.textContent='確認しています。端末の案内が出たら操作してください。';try{const r=await fn();if(r?.redirect){const url=new URL(r.redirect,location.href);if(url.origin!==location.origin)throw Error('戻り先を確認できません。');location.assign(url.href);}else status.textContent='完了しました。';}catch(e){if(e.review||['AbortError','TypeError','SyntaxError'].includes(e.name)){review=true;status.textContent=e.review?e.message:'通信結果を確認できません。同じ操作を繰り返さず、画面を開き直して状態を確認してください。';reopen.hidden=false;setTimeout(()=>{reopen.disabled=false;},e.delay||0);}else status.textContent=e.name==='NotAllowedError'?'端末の確認が中断されました。もう一度お試しください。':e.message||'確認できませんでした。';}finally{busy=false;if(!review)document.querySelectorAll('button').forEach(b=>b.disabled=false);}}
async function ceremony(prefix,register){if(!window.PublicKeyCredential||!window.isSecureContext)throw Error('この端末のHTTPS対応ブラウザで開いてください。');const r=await post(prefix+'_options',{password:value('password')});const options=convert(r.options);const pk=options.publicKey;const decode=s=>Uint8Array.from(atob(s.replace(/-/g,'+').replace(/_/g,'/')),c=>c.charCodeAt(0));if(typeof pk.challenge==='string')pk.challenge=decode(pk.challenge);if(pk.user&&typeof pk.user.id==='string')pk.user.id=decode(pk.user.id);for(const name of ['excludeCredentials','allowCredentials'])for(const x of pk[name]||[])if(typeof x.id==='string')x.id=decode(x.id);const ac=new AbortController(),timer=setTimeout(()=>ac.abort(),65000);let c;try{c=register?await navigator.credentials.create({...options,signal:ac.signal}):await navigator.credentials.get({...options,signal:ac.signal});}finally{clearTimeout(timer);}if(!c)throw Error('端末の確認が中断されました。');const data={id:encode(c.rawId),clientDataJSON:encode(c.response.clientDataJSON),label:value('label')};if(register)data.attestationObject=encode(c.response.attestationObject);else{data.authenticatorData=encode(c.response.authenticatorData);data.signature=encode(c.response.signature);data.userHandle=c.response.userHandle?encode(c.response.userHandle):null;}return post(prefix==='verify'?'verify_passkey':prefix+'_verify',data);}
bind('claim',()=>post('claim_ticket',{password:value('password'),ticket:value('ticket')}));bind('change-password',()=>post('change_password',{password:value('password'),new_password:value('new-password')}));
bind('register',()=>ceremony('register',true));bind('login-passkey',()=>ceremony('login',false));bind('verify',()=>ceremony('verify',false));
bind('totp-setup',async()=>{const r=await post('totp_setup',{password:value('password')});document.getElementById('totp-secret').textContent='認証アプリの「設定キーを入力」に登録：'+r.secret;});bind('totp-verify',()=>post('verify_totp',{password:value('password'),code:value('code')}));
for(const b of document.querySelectorAll('[data-revoke]'))b.addEventListener('click',()=>{if(confirm('この端末のパスキーを失効しますか？'))run(()=>post('revoke',{id:b.dataset.revoke,password:value('password')}));});})();</script>
