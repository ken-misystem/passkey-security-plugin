<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>スタッフのメール・初回登録</title>{% include '@PasskeySecurity/favicon.twig' %}{% include '@PasskeySecurity/security_style.twig' %}
<style nonce="{{ nonce }}">.mail-shell{max-width:900px;padding-top:16px}.mail-shell h1{font-size:1.5rem;margin:0 0 6px}.mail-shell h2{font-size:1.12rem}.mail-shell p{margin:6px 0 10px}.mail-shell .card{padding:18px;margin:12px 0}.mail-shell nav{font-size:.85rem;margin:8px 0 12px}.mail-address{overflow-wrap:anywhere}.identity-check,.initial-delivery label{display:flex;gap:8px;align-items:flex-start;font-size:.9rem}.identity-check input[type=checkbox],.initial-delivery input[type=radio]{width:18px;height:18px;min-height:0;padding:0;flex:0 0 auto;margin:4px 0 0}.initial-delivery{padding:8px 12px;margin:10px 0;border:1px solid var(--line);border-radius:7px}.initial-delivery label{margin:6px 0}.initial-delivery small{display:block;font-size:.8rem;font-weight:400}.code-current{background:var(--soft);padding:10px 12px;border-radius:8px;font-size:.87rem}.code-current dl{display:grid;grid-template-columns:6em 1fr;gap:2px 8px;margin:6px 0}.code-current dt{color:var(--muted)}.code-current dd{margin:0}.code-current p{margin-bottom:0}.code-history{padding-left:0;list-style:none}.code-history li{padding:8px 0;border-bottom:1px solid var(--line);font-size:.88rem}.code-history time{display:block;color:var(--muted);font-size:.82rem}.mail-shell details{margin-top:12px}.mail-shell summary{font-size:.88rem;padding:8px 0}.mail-shell button{max-width:100%;white-space:normal;min-height:42px;padding:9px 14px}.mail-shell .notice{padding:10px 12px;margin:10px 0}.code-current[data-code-state=expired] .badge{background:#fff0dc;color:#854d0c}@media(max-width:680px){.mail-shell{padding:12px 14px}.mail-shell .card{padding:14px}.code-current dl{grid-template-columns:1fr}.code-current dd{margin:0 0 3px}.mail-shell .topbar{padding:8px 14px}}.staff-mail-admin-page .topbar{padding:8px 14px}.staff-mail-admin-page .topbar span{display:inline;margin-left:8px}.mail-shell h1{font-size:1.25rem}.mail-shell nav{line-height:1.5}.code-current dl{grid-template-columns:4.5em 1fr;font-size:.8rem}.code-current dd{margin:0}.code-current dt{margin:0}</style></head><body class="staff-mail-admin-page"><header class="topbar">{{ passkey_store_appearance().name }} <span>スタッフ設定</span></header><main id="main" class="mail-shell"><h1>スタッフ設定</h1><p>対象：<strong>{{ member.name }}</strong>（ID {{ member.id }}）</p><nav><a href="{{ path('admin_setting_system_member_edit',{'id':member.id}) }}">編集へ</a> / <a href="{{ path('admin_setting_system_member') }}">一覧へ</a> / <a href="#mail-address-settings">メール設定</a> / <a id="initial-status-refresh" href="{{ path('admin_ps_staff_mail',{id:member.id}) }}">状況更新</a></nav>
{% if message %}<p class="notice" id="staff-operation-result" role="status">{{ message }}</p>{% endif %}
<section class="card" id="initial-code-panel"><h2>初回登録リンク・コード／登録状況</h2>
<div class="code-current" data-code-state="{{ initial_overview.state }}"><strong class="badge" id="initial-current-status">{{ initial_overview.label }}</strong>
<dl><dt>最終発行</dt><dd id="initial-issued-at">{{ initial_overview.issued_at ? initial_overview.issued_at|date('Y/m/d H:i','Asia/Tokyo')~' JST' : '発行記録なし' }}</dd>{% if initial_overview.expires_at and initial_overview.code_unused %}<dt>有効期限</dt><dd id="initial-expires-at">{{ initial_overview.expires_at|date('Y/m/d H:i','Asia/Tokyo') }} JST</dd>{% endif %}</dl><p id="initial-next-action">{{ initial_overview.next }}</p>
{% if not can_edit %}<p>非稼働のため変更できません。</p>{% endif %}</div>
{% if ticket %}<p class="notice">初回登録コード（今回のみ表示）：<code class="mail-address" id="initial-code">{{ ticket }}</code></p>
{% elseif can_initial %}<form method="post" id="initial-code-issue-form"><input type="hidden" name="initial_revision" value="{{ initial_revision }}"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_admin_'~member.id) }}"><input type="hidden" name="revision" value="{{ revision }}">{% set initial_has_email = addresses.primary.verified or addresses.backup.verified %}
<fieldset class="initial-delivery"><legend>コードの渡し方</legend><label for="initial-delivery-email"><input type="radio" id="initial-delivery-email" name="initial_delivery" value="email" required{% if initial_has_email %} checked{% endif %}{% if not initial_has_email or not can_edit %} disabled{% endif %}><span>登録リンクをメールへ送信する{% if initial_has_email %}<small class="mail-address">{{ addresses.primary.verified ?? addresses.backup.verified }}</small>{% else %}<small>「メールアドレス設定」で、本人のアドレスを確認してください。</small>{% endif %}</span></label>
<label for="initial-delivery-display"><input type="radio" id="initial-delivery-display" name="initial_delivery" value="display" required{% if not initial_has_email %} checked{% endif %}{% if not can_edit %} disabled{% endif %}><span>この画面に表示して、別の方法で本人へ渡す</span></label></fieldset>
<label class="identity-check"><input type="checkbox" name="identity_checked" value="1" required{% if not can_edit %} disabled{% endif %}>本人であることを確認しました</label><button name="action" value="initial"{% if not can_edit %} disabled{% endif %}>{{ initial_overview.state == 'not_issued' ? '登録リンク・コードを発行' : '新しい登録リンク・コードを発行' }}</button></form>{% endif %}
<details id="initial-code-history"><summary>発行・登録の履歴（{{ initial_overview.history_truncated ? '直近30' : initial_overview.events|length }}件）</summary><ul class="code-history">{% for event in initial_overview.events %}<li><time>{{ event.at|date('Y/m/d H:i:s','Asia/Tokyo') }} JST</time><span>{{ event.label }}</span></li>{% else %}<li>記録された履歴はありません。</li>{% endfor %}</ul>
{% if initial_overview.claimed_at %}<p class="muted">最後のコード確認：{{ initial_overview.claimed_at|date('Y/m/d H:i:s','Asia/Tokyo') }} JST</p>{% endif %}{% if initial_overview.completed_at %}<p class="muted" id="initial-completed-at">登録完了の記録：{{ initial_overview.completed_at|date('Y/m/d H:i:s','Asia/Tokyo') }} JST</p>{% endif %}
<p class="muted">保存済みの記録を表示しています。古いコードや秘密情報は再表示しません。同じ秒の記録の前後関係は省略しています。</p></details>
<details><summary>ヘルプ：コード発行・期限・メールの状態</summary><div class="help-body"><ul><li>本人確認後、通常は確認済みメールへ登録リンクを送ります。メールが使えない場合はコードを別の方法で渡し、本人がパスキーか認証アプリを登録します。発行だけでは登録完了になりません。</li><li>リンク・コードは1時間・1回限りです。再発行すると以前のリンク・コードは使えません。</li><li>「登録リンクをメールへ送信する」を選んで発行すると、送信を予約します。受信箱への到着確認ではありません。配送履歴も確認してください。</li><li>使用済みコードのあと、登録途中で本人確認期限が切れた場合は、管理担当者による本人確認を伴う復旧が必要です。</li><li>登録済みの認証器を、この画面から解除することはありません。</li></ul></div></details></section>
<section id="mail-address-settings"><h2>メールアドレス設定</h2>{% for slot,label in {'primary':'主アドレス','backup':'予備アドレス'} %}<section class="card" data-mail-slot="{{ slot }}"><h2>{{ label }}</h2><p>確認済み：<strong class="mail-address">{{ addresses[slot].verified|default('未登録') }}</strong></p><p>確認待ち：<span class="mail-address">{{ addresses[slot].pending|default('なし') }}</span></p>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_admin_'~member.id) }}"><input type="hidden" name="revision" value="{{ revision }}"><input type="hidden" name="slot" value="{{ slot }}"><label for="email-{{ slot }}">登録・変更するアドレス</label><input type="email" id="email-{{ slot }}" name="email" value="{{ addresses[slot].pending ?? addresses[slot].verified ?? '' }}" required maxlength="254" autocomplete="off"{% if not can_edit %} disabled{% endif %}>
<button name="action" value="stage"{% if not can_edit %} disabled{% endif %}>保存だけ行う</button> <button name="action" value="verify"{% if not can_edit %} disabled{% endif %}>確認メールを予約する</button><p><button class="danger" name="action" value="revoke" formnovalidate{% if not can_edit %} disabled{% endif %}>このアドレスを解除する</button></p><p class="muted">保存だけではメールは送りません。確認メールを予約すると、本人へ確認を依頼します。</p></form></section>{% endfor %}<details><summary>ヘルプ：メールアドレスの確認・変更</summary><ul><li>保存だけではメールを送りません。「確認メールを予約する」でスタッフ本人へ確認を依頼します。</li><li>本人が確認するまで、以前の確認済みアドレスを維持します。</li><li>確認済みの主・予備アドレスから、パスワード再設定を依頼できます。</li><li>パスワード・パスキー・認証アプリの登録状態は変更しません。</li></ul></details></section></main></body></html>