{% if form.vars.ps_staff_mail_admin|default(false) %}
{{ form_widget(form.ps_mail_revision) }}
{{ form_errors(form) }}
<div class="alert alert-info ps-admin-mail-summary text-break">
<strong>スタッフの再設定用メール</strong>
{% if Member.id %}{% for slot,label in {'primary':'主アドレス','backup':'予備アドレス'} %}<p class="mb-1">{{ label }}：確認済み {{ form.vars.ps_staff_mail_addresses[slot].verified ?? '未登録' }} / 確認待ち {{ form.vars.ps_staff_mail_addresses[slot].pending ?? 'なし' }}</p>{% endfor %}
<a class="btn btn-outline-primary btn-sm" href="{{ path('admin_ps_staff_mail',{id:Member.id}) }}">メール確認・変更／初回登録コード</a>
{% else %}<p class="mb-1">主アドレスを入力してメンバーを保存すると、確認待ちとして登録されます。保存後の「メール確認・変更」から確認メールと初回登録コードを準備できます。</p>{% endif %}
<p class="small mb-0">保存だけではメールは送信されません。新しいアドレスは本人の確認後に有効になります。空欄は現在の登録を保持し、解除はメール管理画面から行います。</p>
</div>{% endif %}
