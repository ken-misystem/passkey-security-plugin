{% set heading = mode == 'initial_email' ? 'スタッフのメールアドレスを確認する' : (mode == 'initial_request' ? (resume_request|default(false) ? '登録の再開・復旧コードを依頼する' : '初回登録リンク・コードを依頼する') : (mode == 'manage' ? '再設定用メールアドレス' : (mode == 'verify' ? 'スタッフメールアドレスの確認' : 'スタッフ認証情報の再設定'))) %}
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ heading }}</title>{% include '@PasskeySecurity/favicon.twig' %}{% include '@PasskeySecurity/security_style.twig' %}</head>
<body><a class="skip" href="#main">手続きへ移動</a><header class="topbar">{{ passkey_store_appearance().name }} <span>スタッフのアカウント設定</span></header><main id="main" class="mail-shell"><p class="eyebrow">{{ mode in ['initial_request','initial_email'] ? 'スタッフの初回登録' : 'メールアドレス・パスワード' }}</p><h1>{{ heading }}</h1>
<p class="status-inline" role="status">{{ message }}</p>
{% if mode == 'manage' or mode == 'initial_email' or not success %}
{% if mode == 'initial_email' %}
<section class="card"><h2>登録されたメールを確認する</h2><p>管理者が登録した本人のメールアドレスを確認してから、登録リンクの依頼へ進みます。パスワードの再発行ではありません。</p>
{% if initial_revision|default('') == '' %}<p class="notice">本人確認の有効期限が切れています。ID・パスワードでログインし直してください。パスワードの再発行は不要です。</p><p><a class="button" href="{{ path('admin_login') }}">ID・パスワードでログイン</a></p>{% else %}{% if initial_address %}<p>確認先：<strong>{{ initial_address.address }}</strong></p><form method="post" id="initial-email-form"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_initial_email') }}"><input type="hidden" name="revision" value="{{ initial_revision }}"><p>届いていない・なくした・期限が切れた場合も、同じボタンで送り直せます。再送後は最新のメールで確認してください。</p><button type="submit">確認メールを送る・送り直す</button></form>
{% else %}<p class="notice">管理者が登録した確認待ちメールアドレスがありません。管理者にメールアドレスの登録を依頼してください。この画面から任意の別アドレスへは送信できません。</p>{% endif %}
<p><a class="button" id="initial-email-continue" href="{{ path('ps_member') }}">メールの確認を済ませたので次へ</a></p>{% endif %}<p><a id="initial-email-unavailable" href="{{ path('ps_staff_initial_request') }}">メールが使えない場合：管理者へコードを依頼する</a></p></section>
{% elseif mode == 'initial_request' %}
<section class="card"><h2>システム管理者へ依頼する</h2><p>{{ resume_request|default(false) ? '登録途中で進めなくなった場合、管理者に本人確認と登録の再開を依頼します。' : '管理者の本人確認後に、確認済みメールへ登録リンクが届きます。メールが使えない場合はコードを別の方法で受け取れます。' }}</p>
<form method="post" id="initial-code-request"><input type="hidden" name="request_kind" value="{{ resume_request|default(false) ? 'resume' : 'initial' }}"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_initial_request') }}"><label for="request-login-id">スタッフのログインID</label><input type="text" id="request-login-id" name="login_id" value="{{ login_hint|default('') }}" required maxlength="50" autocomplete="username"><button type="submit">{{ resume_request|default(false) ? '登録の再開・復旧コードを依頼する' : '初回登録リンク・コードを依頼する' }}</button></form>
<p class="muted">パスワード再設定の依頼ではありません。依頼だけでリンク・コードは発行されません。</p><details><summary>ヘルプ：依頼後の流れ・届かないとき</summary><ul><li>現在稼働中のシステム管理者へ、必要な場合に依頼を通知します。</li><li>管理者が別の連絡手段で本人確認し、登録リンクまたはコードを用意します。</li><li>連続した依頼は通知をまとめます。連絡がない場合は別の連絡手段で管理者へお問い合わせください。</li><li>パスワードや認証アプリの6桁コードは入力しないでください。</li></ul></details></section>
{% elseif mode == 'request' %}
<section class="card"><h2>再設定メールを受け取る</h2><ul><li>登録済みの主アドレス、または予備アドレスを入力してください。</li><li>届いたメールのリンクから、30分以内に新しいパスワードを設定します。</li></ul>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_request') }}"><label>確認済みメールアドレス <input type="email" name="email" required maxlength="254" autocomplete="email"></label><button>再設定メールを依頼する</button></form></section>
{% elseif mode == 'manage' %}
{% if can_view|default(false) %}
<div class="notice"><ul><li>普段使う主アドレスと、受信できなくなった場合の予備アドレスを各1件登録できます。</li><li>届いた確認メールで手続きすると、そのアドレスが使えるようになります。</li><li>登録・解除には直近のパスキー、または認証アプリによる本人確認が必要です。</li></ul></div>
<section class="card"><h2>登録済みメールアドレス</h2>
{% for slot, label in {'primary':'主アドレス','backup':'予備アドレス'} %}<div class="mail-state" data-mail-slot="{{ slot }}"><h3>{{ label }}</h3><p>確認済み：{{ addresses[slot].verified|default('未登録') }}</p><p>確認待ち：{{ addresses[slot].pending|default('なし') }}</p></div>{% endfor %}
</section><section class="card"><h2>メールアドレスを登録・変更する</h2>
{% if not can_edit|default(false) %}<p class="notice">変更するには、<a href="{{ path('ps_member') }}">パスキー・認証アプリで本人確認</a>をやり直してください。登録内容は引き続き確認できます。</p>{% endif %}
<form method="post" id="staff-mail-manage"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_manage') }}">
<label for="mail-slot">操作するアドレス</label><select{% if not can_edit|default(false) %} disabled{% endif %} name="slot" id="mail-slot"><option value="primary" data-pending="{{ addresses.primary.pending ?? addresses.primary.verified ?? '' }}">主アドレス</option><option value="backup" data-pending="{{ addresses.backup.pending ?? addresses.backup.verified ?? '' }}">予備アドレス</option></select>
<label for="mail-address">登録・変更するメールアドレス</label><input{% if not can_edit|default(false) %} disabled{% endif %} type="email" id="mail-address" name="email" required maxlength="254" autocomplete="email" value="{{ addresses.primary.pending ?? addresses.primary.verified ?? '' }}">
<p class="muted">アドレスを選び、確認メールを送るか登録を解除してください。解除には新しいメールアドレスの入力は不要です。</p>
<button{% if not can_edit|default(false) %} disabled{% endif %} name="action" value="verify">確認メールを予約する</button> <button{% if not can_edit|default(false) %} disabled{% endif %} class="danger" name="action" value="revoke" formnovalidate>選択したアドレスの登録を解除する</button></form><script nonce="{{ nonce }}">(()=>{const slot=document.getElementById('mail-slot'),field=document.getElementById('mail-address'),edits={};let previous=slot.value;slot.addEventListener('change',()=>{edits[previous]=field.value;field.value=edits[slot.value]??slot.selectedOptions[0].dataset.pending??'';previous=slot.value;});})();</script></section>
{% else %}<p class="notice">登録内容を表示するには、ログインと追加認証が必要です。表示できないことは、未登録を意味しません。</p>{% endif %}
{% else %}
<section class="card"><h2>{{ mode == 'reset' ? '新しいパスワードを設定する' : 'メールアドレスの確認を完了する' }}</h2><ul><li>メールに記載されたリンクから、この画面を開いてください。</li><li>「{{ mode == 'reset' ? 'パスワードを変更する' : 'メールアドレスを確認する' }}」を押すと手続きが完了します。画面を開いただけでは完了しません。</li></ul>
<form method="post" id="confirm"><input type="hidden" name="_token" value="{{ csrf_token('ps_staff_mail_'~mode) }}"><input type="hidden" name="token" id="mail-token">{% if verification_initial|default(false) %}<input type="hidden" name="registration" value="1">{% endif %}
{% if mode == 'reset' %}{% include '@PasskeySecurity/password_help.twig' with {password_context:'staff_reset'} %}<label>新しいパスワード（半角12～200文字）<input type="password" name="password" required minlength="{{ constant('Plugin\\PasskeySecurity\\Resource\\Runtime\\PasswordRules::MIN_LENGTH') }}" maxlength="{{ constant('Plugin\\PasskeySecurity\\Resource\\Runtime\\PasswordRules::MAX_LENGTH') }}" pattern="{{ constant('Plugin\\PasskeySecurity\\Resource\\Runtime\\PasswordRules::HTML_PATTERN') }}" autocomplete="new-password"></label><label>新しいパスワード（確認）<input type="password" name="repeat" required minlength="{{ constant('Plugin\\PasskeySecurity\\Resource\\Runtime\\PasswordRules::MIN_LENGTH') }}" maxlength="{{ constant('Plugin\\PasskeySecurity\\Resource\\Runtime\\PasswordRules::MAX_LENGTH') }}" pattern="{{ constant('Plugin\\PasskeySecurity\\Resource\\Runtime\\PasswordRules::HTML_PATTERN') }}" autocomplete="new-password"></label>{% endif %}
<button id="submit" disabled>{{ mode == 'reset' ? 'パスワードを変更する' : 'メールアドレスを確認する' }}</button></form>
<script nonce="{{ nonce }}">const raw=new URLSearchParams(location.hash.slice(1)).get('token')||'';if(/^[A-Za-z0-9_-]{43}$/.test(raw)){document.getElementById('mail-token').value=raw;document.getElementById('submit').disabled=false;}history.replaceState(null,'',location.pathname);</script></section>
{% endif %}{% endif %}
{% if mode == 'initial_request' %}
<section class="card" id="initial-request-next">{% if resume_request|default(false) %}<h2>復旧コードを受け取った方</h2><p>管理者の本人確認と復旧コードの発行をお待ちください。使用済みの登録リンクや初回登録コードでは再開できません。</p><a class="button" id="initial-code-continue" href="{{ initial_signed|default(false) ? path('ps_member',{setup:'code'}) : path('admin_login') }}">{{ initial_signed|default(false) ? '復旧コードを入力して再開する' : 'ID・パスワードでログインして復旧コードを入力する' }}</a>
{% else %}<h2>{{ success ? '管理者からの登録リンクをお待ちください' : '登録リンクを受け取った方' }}</h2><p>メールに届いた最新の登録リンクを開き、「登録を始める」を押してください。この画面へのコード入力は不要です。</p><p>リンクは発行から1時間・1回限りです。期限切れなら新しいリンクを管理者へ依頼してください。</p><details id="manual-code-help"><summary>メールが使えない・コードを受け取った方</summary><p>管理者に本人確認してもらい、コードを別の方法で受け取ってください。受け取った後に次のボタンを使います。</p><a class="button" id="initial-code-continue" href="{{ initial_signed|default(false) ? path('ps_member',{setup:'code'}) : path('admin_login') }}">{{ initial_signed|default(false) ? '受け取ったコードを入力する' : 'ID・パスワードでログインしてコードを入力する' }}</a></details>{% endif %}</section>
{% elseif mode == 'verify' and success %}<section class="card" id="verification-next">
{% if verification_account|default(false) %}<h2>アカウント設定へ戻る</h2><p>メールの確認が完了しました。パスワードや認証器の再登録は不要です。</p><a class="button" id="staff-account-continue" href="{{ path('ps_staff_email_manage') }}">登録メールアドレスの設定へ戻る</a>
{% elseif verification_initial|default(false) %}<h2>次に、管理者へ登録リンクを依頼する</h2><p>メールの確認だけでは初回登録は完了していません。管理者が本人確認した後に届く登録リンクから、パスキーまたは認証アプリを登録してください。</p><a class="button" id="initial-registration-continue" href="{{ path('ps_staff_initial_request') }}">管理者へ初回登録リンク・コードを依頼する</a>
{% else %}<h2>メールの確認が完了しました</h2><a class="button" id="staff-verified-login" href="{{ path('admin_login') }}">スタッフのログイン画面へ</a><p>初回登録がまだの方は、<a href="{{ path('ps_staff_initial_request') }}">管理者へ登録リンクを依頼</a>してください。</p>{% endif %}</section>{% endif %}
<p><a href="{{ path('admin_login') }}">ID・パスワードのログイン画面へ</a>{% if mode == 'manage' %} / <a href="{{ path('ps_member') }}">パスキー・認証アプリの設定へ</a>{% endif %}</p>
<details><summary>パスワードを忘れた場合だけ</summary><p><a id="staff-password-reset-link" href="{{ path('ps_staff_password_reset') }}">パスワード再設定へ</a>（必要な場合に、自分で選んで進んでください）</p></details>
<details><summary>ヘルプ：メールが届かない・ログインできない</summary><div class="help-body"><ul><li>迷惑メールフォルダと、入力したメールアドレスをご確認ください。</li><li>同じスタッフの再設定メールは、5分以上間隔を空けて依頼してください。</li><li>メールアドレスが未登録・受信できない場合は、管理担当者へ連絡してください。</li><li>パスワードを変更しても、パスキー・認証アプリの設定は保持されます。</li><li>端末をすべて紛失した場合は、管理担当者による本人確認が必要です。</li></ul></div></details>
{% if mode in ['verify','reset'] %}<script nonce="{{ nonce }}">window.addEventListener('hashchange',()=>{const token=new URLSearchParams(location.hash.slice(1)).get('token')||'';if(/^[A-Za-z0-9_-]{43}$/.test(token))location.reload();});</script>{% endif %}</main></body></html>
