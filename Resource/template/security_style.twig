<style nonce="{{ nonce }}">
:root{color-scheme:light;--ink:#203044;--muted:#536477;--line:#d5dee5;--accent:#175e68;--soft:#edf5f4;--paper:#fffefa}
select{display:block;width:100%;min-height:46px;padding:10px 12px;margin:6px 0 14px;border:1px solid #9daebb;border-radius:7px;background:white;color:var(--ink);font:inherit}.password-help{background:var(--soft);border-left:3px solid var(--accent);padding:12px 16px;margin:12px 0;line-height:1.7}.password-help ul{margin-bottom:0}.mail-state+.mail-state{margin-top:12px}*{box-sizing:border-box}body{margin:0;background:#edf0f2;color:var(--ink);font:16px/1.8 system-ui,-apple-system,"Noto Sans JP","Yu Gothic",sans-serif;overflow-wrap:anywhere}
a{color:#125c83;text-underline-offset:4px}a:hover{text-decoration-thickness:2px}.skip{position:absolute;top:-100px;left:16px;background:white;padding:12px;z-index:3}.skip:focus{top:12px}
.topbar{background:#203044;border-bottom:4px solid #b9a16a;color:#fff;padding:17px max(20px,calc((100% - 1080px)/2));font-weight:700;letter-spacing:.08em}.topbar span{font-size:.78rem;color:#dae4ec;margin-left:12px;letter-spacing:0;font-weight:400}
main{max-width:1120px;margin:auto;padding:32px 20px 56px}h1{font-size:clamp(1.55rem,3.5vw,2.15rem);line-height:1.5;margin:4px 0 12px}h2{font-size:1.25rem;margin:0 0 12px;line-height:1.6}h3{font-size:1rem;margin:20px 0 8px}p{margin:8px 0 16px}ul,ol{padding-left:1.5em;margin:8px 0 16px}li+li{margin-top:6px}.eyebrow{font-size:.78rem;letter-spacing:.1em;color:var(--muted);font-weight:700;margin:0}.lead{color:var(--muted);max-width:52em}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}.card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:26px;box-shadow:0 4px 12px #20304405;min-width:0;margin-bottom:20px}.grid>.card{margin:0;height:100%}.section-number{color:var(--accent);font-size:.8rem;font-weight:700;letter-spacing:.05em;margin-bottom:6px}.notice{border-left:4px solid var(--accent);background:var(--soft);padding:16px 20px;border-radius:0 10px 10px 0;margin:16px 0 24px}.notice p:last-child,.notice ul:last-child{margin-bottom:0}.badge{display:inline-block;background:#e1efea;color:#235849;border-radius:30px;padding:2px 12px;font-size:.82rem;font-weight:700}.muted{color:var(--muted);font-size:.9rem}.nav{display:flex;flex-wrap:wrap;gap:10px 20px;margin:20px 0 24px}.nav a{padding:4px 0}.fields{display:grid;gap:14px;margin:16px 0}.fields label,label{display:block;font-weight:600;font-size:.95rem}input{display:block;width:100%;max-width:100%;min-height:46px;padding:10px 12px;margin:6px 0 14px;border:1px solid #9daebb;border-radius:7px;background:white;color:var(--ink);font:inherit}input[type=hidden]{display:none}button,.button{display:inline-block;max-width:100%;background:var(--accent);color:#fff;border:1px solid var(--accent);border-radius:7px;padding:11px 18px;font:inherit;font-size:.95rem;font-weight:650;line-height:1.5;text-align:center;cursor:pointer;text-decoration:none;white-space:normal;min-height:46px}button:hover,.button:hover{background:#114954;color:white}.secondary{background:white;color:var(--accent)}.danger{background:#fff5f2;color:#953c30;border-color:#d4aaa3}.danger:hover{background:#fbe2db;color:#74291f}button:disabled{opacity:.55;cursor:wait}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #b18115;outline-offset:4px}form+form{margin-top:20px}details{border-top:1px solid var(--line);margin-top:20px;padding-top:6px}summary{list-style:none;display:flex;align-items:center;gap:12px;padding:12px 0;cursor:pointer;font-weight:650;font-size:.95rem}summary::-webkit-details-marker{display:none}summary::after{content:"＋";margin-left:auto;color:var(--accent);font-size:1.45rem;line-height:1}details[open]>summary::after{content:"−"}.help-body{color:var(--muted);font-size:.92rem;padding:0 4px 8px}.help-body strong{color:var(--ink)}.divider{border-top:1px solid var(--line);margin:24px 0}.downloads{display:grid;gap:10px}.downloads a{display:block;border:1px solid var(--line);border-radius:8px;padding:10px 12px;background:#f5f8fa}.downloads small{display:block;color:var(--muted)}.credentials{list-style:none;padding:0}.credentials li{border-bottom:1px solid var(--line);padding:14px 0}.credentials button{margin-top:8px;display:block}.key-name{font-weight:650}.key-id{font-size:.8rem;color:var(--muted)}#totp-provision{margin:16px 0;padding:16px;background:#fff6dc;border:1px solid #dbc48a;border-radius:8px}#totp-secret{display:block;padding:12px;background:white;font-family:monospace;word-break:break-all;user-select:all}.status{position:sticky;bottom:12px;background:#e4f1ed;border:1px solid #82ada1;border-radius:10px;padding:14px 18px;box-shadow:0 3px 16px #20304415;margin-top:24px}.status:empty{display:none}[hidden]{display:none!important}.footer{font-size:.87rem;color:var(--muted);margin-top:28px}.full{margin-top:24px}.actions{display:flex;gap:10px;flex-wrap:wrap}.mail-shell{max-width:860px}.mail-shell main{max-width:860px}.mail-state{background:#f0f4f6;padding:12px;border-radius:8px}.mail-state p{margin:3px 0}.status-inline:empty{display:none}.status-inline{background:var(--soft);padding:14px;border-radius:8px}
@media(max-width:680px){main{padding:24px 14px 40px}.grid{grid-template-columns:1fr;gap:16px}.card{padding:20px 17px;border-radius:11px}.topbar{padding:14px 18px}.topbar span{display:block;margin:0}.actions>*{width:100%}button,.button{width:100%}.nav{gap:8px 16px}.notice{padding:14px}.status{bottom:8px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
.downloads .app-download{background:#f5f8fa;border:1px solid var(--line);border-radius:10px;padding:16px}.app-download h4{margin:0 0 8px;color:var(--ink);font-size:.95rem}.store-links{display:flex;flex-wrap:wrap;align-items:start;gap:0 8px}.downloads .store-links a{display:flex;flex-direction:column;gap:8px;padding:12px;border:0;background:transparent;flex:0 0 auto;text-decoration:none}.store-links a span{font-size:.82rem;color:var(--muted)}.store-links img{display:block;object-fit:contain;max-width:100%}.badge-credit{font-size:.7rem;margin:10px 0 0;color:var(--muted)}
</style>
