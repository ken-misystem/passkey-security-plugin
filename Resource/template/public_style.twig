<style nonce="{{ nonce }}">*{box-sizing:border-box}body{margin:0;background:#f3f6f8;color:#20344a;font:16px/1.7 system-ui,sans-serif}header{background:#20344a;color:white;padding:16px 24px}main{max-width:880px;margin:24px auto;padding:0 18px}section,.notice{padding:20px;margin:16px 0;background:white;border:1px solid #cfdae3;border-radius:12px}h1{font-size:1.7rem}h2{font-size:1.2rem}label{display:block;margin-top:12px}input:not([type=checkbox]){display:block;width:100%;max-width:560px;padding:12px;border:1px solid #8799aa;border-radius:6px;font:inherit}button,.button{display:inline-block;margin:12px 8px 6px 0;padding:11px 18px;border:0;border-radius:6px;background:#14616e;color:white;text-decoration:none;font:inherit;cursor:pointer}button:disabled{opacity:.55;cursor:wait}a{color:#12536a}nav{display:flex;gap:20px;flex-wrap:wrap}#status{min-height:1.8em}details{padding:12px 0}summary{cursor:pointer}code{overflow-wrap:anywhere}.error{color:#a52a2a}li{margin-bottom:8px}</style>
