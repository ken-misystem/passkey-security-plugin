<script nonce="{{ nonce }}">(() => {const tabs=[...document.querySelectorAll('[data-auth-method]')];if(!tabs.length)return;function select(tab,remember){for(const t of tabs){const on=t===tab;t.setAttribute('aria-selected',String(on));t.tabIndex=on?0:-1;document.getElementById(t.getAttribute('aria-controls')).hidden=!on;}if(remember)history.replaceState(null,'','#'+tab.getAttribute('aria-controls'));}select(tabs.find(t=>'#'+t.getAttribute('aria-controls')===location.hash)||tabs[0],false);tabs.forEach((t,i)=>{t.addEventListener('click',()=>select(t,true));t.addEventListener('keydown',e=>{let n;if(e.key==='ArrowLeft'||e.key==='ArrowRight')n=tabs[(i+1)%tabs.length];else if(e.key==='Home')n=tabs[0];else if(e.key==='End')n=tabs[tabs.length-1];if(n){e.preventDefault();select(n,true);n.focus();}});});document.querySelectorAll('[data-auth-alternative="totp"]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const tab=tabs.find(t=>t.dataset.authMethod==='totp');if(tab){select(tab,true);document.getElementById('totp-section').scrollIntoView({block:'start',behavior:'smooth'});tab.focus({preventScroll:true});}}));document.querySelectorAll('a[href="#registered-devices"]').forEach(a=>a.addEventListener('click',()=>{document.getElementById('registered-devices').open=true;}));})();</script>